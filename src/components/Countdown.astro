---
interface Props {
  // Evergreen: each visitor gets their own deadline, persisted so it survives
  // reloads/repeat visits in the same browser. Falls back to a fixed campaign
  // deadline instead if `fixedDeadline` (ISO string) is supplied.
  durationHours?: number;
  fixedDeadline?: string;
  storageKey?: string;
  align?: 'center' | 'start';
  shape?: 'card' | 'circle';
}

const {
  durationHours = 48,
  fixedDeadline,
  storageKey = 'claudia_offer_deadline',
  align = 'center',
  shape = 'card',
} = Astro.props;
---

<div
  class:list={['countdown', align, shape]}
  data-countdown
  data-duration-hours={durationHours}
  data-fixed-deadline={fixedDeadline ?? ''}
  data-storage-key={storageKey}
>
  <div class="countdown-unit">
    <span class="countdown-value" data-unit="hours">00</span>
    <span class="countdown-label">ساعة</span>
  </div>
  <div class="countdown-unit">
    <span class="countdown-value" data-unit="minutes">00</span>
    <span class="countdown-label">دقيقة</span>
  </div>
  <div class="countdown-unit">
    <span class="countdown-value" data-unit="seconds">00</span>
    <span class="countdown-label">ثانية</span>
  </div>
</div>

<style>
  .countdown {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
  }
  .countdown.start {
    justify-content: flex-start;
  }
  .countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.5rem;
    padding: 0.65rem 0.4rem;
    background: linear-gradient(180deg, var(--bg-dark-raised), var(--card-bg));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-xs), inset 0 1px 0 var(--surface-highlight);
  }
  .countdown-value {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }
  .countdown-label {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .countdown.circle {
    gap: var(--space-md);
  }
  .countdown.circle .countdown-unit {
    justify-content: center;
    gap: 0.15rem;
    width: 4.5rem;
    height: 4.5rem;
    min-width: 0;
    padding: 0;
    border-radius: 50%;
    background: var(--surface-tint);
    border: none;
    box-shadow: none;
  }
  .countdown.circle .countdown-value {
    font-size: 1.4rem;
  }
</style>

<script>
  function initCountdown(root) {
    const durationHours = Number(root.dataset.durationHours) || 48;
    const fixedDeadline = root.dataset.fixedDeadline;
    const storageKey = root.dataset.storageKey || 'claudia_offer_deadline';

    const getDeadline = () => {
      if (fixedDeadline) {
        const t = Date.parse(fixedDeadline);
        return Number.isNaN(t) ? Date.now() + durationHours * 3600000 : t;
      }

      let stored = null;
      try {
        stored = window.localStorage.getItem(storageKey);
      } catch (_) {
        // localStorage can throw in locked-down/private WebViews; fall back silently.
      }

      let deadline = stored ? Number(stored) : NaN;

      if (!Number.isFinite(deadline) || deadline <= Date.now()) {
        deadline = Date.now() + durationHours * 3600000;
        try {
          window.localStorage.setItem(storageKey, String(deadline));
        } catch (_) {}
      }

      return deadline;
    };

    const deadline = getDeadline();
    const els = {
      hours: root.querySelector('[data-unit="hours"]'),
      minutes: root.querySelector('[data-unit="minutes"]'),
      seconds: root.querySelector('[data-unit="seconds"]'),
    };

    const pad = (n) => String(Math.max(0, n)).padStart(2, '0');

    function tick() {
      const remaining = deadline - Date.now();
      if (remaining <= 0) {
        root.dispatchEvent(new CustomEvent('countdown:expired'));
        els.hours.textContent = '00';
        els.minutes.textContent = '00';
        els.seconds.textContent = '00';
        return;
      }
      const totalSeconds = Math.floor(remaining / 1000);
      els.hours.textContent = pad(Math.floor(totalSeconds / 3600));
      els.minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
      els.seconds.textContent = pad(totalSeconds % 60);
      requestAnimationFrame(scheduleNext);
    }

    let lastRun = 0;
    function scheduleNext(now) {
      if (now - lastRun >= 1000) {
        lastRun = now;
        tick();
      } else {
        requestAnimationFrame(scheduleNext);
      }
    }

    tick();
  }

  document.querySelectorAll('[data-countdown]').forEach(initCountdown);
</script>
