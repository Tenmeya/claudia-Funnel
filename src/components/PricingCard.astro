---
import CTAButton from './CTAButton.astro';

interface Props {
  checkoutUrl: string;
  ctaSize?: 'md' | 'lg';
  price?: string;
  originalPrice?: string;
  savingsLabel?: string;
}

const {
  checkoutUrl,
  ctaSize = 'lg',
  price = '٩٩$',
  originalPrice = '١٤٩$',
  savingsLabel = '(وفّر ٣٠٪)',
} = Astro.props;
---

<div class="pricing-card">
  <div class="price-col">
    <div class="price-line">
      <span class="price-current">{price}</span>
      <span class="price-original">{originalPrice}</span>
    </div>
    <span class="price-savings">{savingsLabel}</span>
  </div>
  <CTAButton href={checkoutUrl} size={ctaSize} />
</div>

<style>
  .pricing-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-lg);
    background: linear-gradient(
      135deg,
      rgba(0, 211, 141, 0.14),
      rgba(0, 184, 251, 0.08)
    );
    border: 1px solid rgba(0, 211, 141, 0.28);
    box-shadow: 0 0 32px rgba(0, 211, 141, 0.14);
  }
  .price-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .price-line {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .price-current {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    color: var(--accent-text);
  }
  .price-original {
    font-size: 1.1rem;
    color: var(--text-faint);
    text-decoration: line-through;
  }
  .price-savings {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-text);
  }
</style>
