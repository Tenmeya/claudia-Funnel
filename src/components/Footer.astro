---
import ResponsivePicture from './ResponsivePicture.astro';

interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <ResponsivePicture
      name="tenmeya-logo"
      widths={[120, 240]}
      alt="تنمية"
      sizes="48px"
      aspectRatio={1}
      class="footer-logo"
    />
    <p>دورة كلوديا — عيد المجيبل</p>
    <nav>
      <a class="link-underline" href={checkoutUrl} target="_blank" rel="noopener">التسجيل في الدورة</a>
    </nav>
    <p class="copyright">جميع الحقوق محفوظة © {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-lg);
    padding-block-end: calc(var(--space-lg) + 4rem);
    border-top: 1px solid var(--border-subtle);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .site-footer :global(.footer-logo) {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-sm);
  }
  .site-footer nav {
    margin-block: var(--space-sm);
  }
  .site-footer a {
    color: var(--accent-text);
    font-weight: 600;
  }
  .copyright {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
</style>
