---
import FAQAccordion from './FAQAccordion.astro';

// "Claude Pro subscription required?" is moved up (was #3) since the build
// brief flags it as a real purchase blocker worth surfacing early.
const items = [
  {
    question: 'هل أحتاج خبرة سابقة في Claude أو الذكاء الاصطناعي؟',
    answer:
      'لا. دورة كلوديا مصممة للمبتدئين وتشرح كل شيء خطوة بخطوة من البداية.',
  },
  {
    question: 'هل أحتاج اشتراك Claude Pro؟',
    answer:
      'نعم. بعض مميزات كلوديا تتطلب اشتراك Claude Pro للاستفادة الكاملة من الشرح والتطبيق.',
  },
  {
    question: 'هل أحتاج خبرة في التسويق أو الإعلانات؟',
    answer:
      'لا. لكن إذا كنت تدير حملات إعلانية أو تعمل في التسويق حالياً، راح تستفيد من كلوديا بشكل أكبر.',
  },
  {
    question: 'هل أحتاج معرفة برمجية أو تقنية؟',
    answer: 'أبداً. لن تحتاج إلى كتابة أي كود أو خبرة تقنية مسبقة لبناء كلوديا.',
  },
  {
    question: 'هل راح أتعلم شلون أبني كلوديا خطوة بخطوة؟',
    answer:
      'نعم. الهدف الرئيسي من الدورة هو بناء كلوديا داخل Claude وربطها بمشروعك وحملاتك الإعلانية.',
  },
  {
    question: 'هل راح أتعلم شلون أربط كلوديا بحساب Meta Ads؟',
    answer:
      'نعم. نشرح خطوة بخطوة شلون تربط Claude بحملاتك وتعطي كلوديا القدرة على تحليل البيانات.',
  },
  {
    question: 'هل الدورة نظرية أم عملية؟',
    answer: 'عملية بالكامل. راح تشوف بناء كلوديا وتطبيق كل خطوة أمامك بشكل مباشر.',
  },
  {
    question: 'هل أقدر أطبّق الشرح على مشروعي مباشرة؟',
    answer: 'نعم. كلوديا مصممة لتعمل على مشروعك الحالي وحملاتك الحالية.',
  },
  {
    question: 'كم تستغرق الدورة؟',
    answer: 'حوالي 90 دقيقة مقسمة إلى 15 درس قصير وسهل التطبيق.',
  },
  {
    question: 'ماذا سأحصل مع الدورة؟',
    answer:
      'تحصل على دورة كلوديا كاملة، Skill كلوديا الجاهزة، وأهم الملفات والقوالب التي تحتاجها لبناء مدير التسويق الخاص بك.',
  },
  {
    question: 'هل أحصل على التحديثات المستقبلية؟',
    answer: 'نعم. أي تحديثات مهمة مرتبطة بدورة كلوديا سيتم إضافتها للمشتركين الحاليين.',
  },
  {
    question: 'هل أقدر مشاهدة الدورة أكثر من مرة؟',
    answer: 'نعم. تحصل على وصول كامل لمدة سنة وتقدر ترجع للدروس متى ما احتجت.',
  },
];
---

<section class="section faq-section">
  <div class="container" data-reveal>
    <h2 class="section-title">أسئلة شائعة</h2>
    <FAQAccordion items={items} />
  </div>
</section>

<style>
  .faq-section .container {
    max-width: 720px;
  }
</style>
