---
// Wistia's player.js + per-media embed script are heavy and (on the old
// page) loaded unconditionally on every pageview. Here the <script> tags
// are injected via JS only once the embed is near the viewport; until then
// the custom element sits un-upgraded and shows Wistia's own blurred-swatch
// placeholder (styles below match the swatch CSS in Wistia's embed code).
interface Props {
  mediaId: string;
  aspect?: number;
  label: string;
}

const { mediaId, aspect = 0.5625, label } = Astro.props;
---

<div class="wistia-frame">
  <div class="wistia-glow" aria-hidden="true"></div>
  <div class="wistia-wrap" data-wistia-lazy data-media-id={mediaId}>
    <wistia-player media-id={mediaId} seo="false" aspect={aspect} aria-label={label}
    ></wistia-player>
  </div>
</div>

<style define:vars={{ aspect }}>
  .wistia-frame {
    position: relative;
  }
  .wistia-glow {
    position: absolute;
    inset: -6%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 184, 251, 0.16),
      transparent 65%
    );
    filter: blur(28px);
    z-index: 0;
  }
  .wistia-wrap {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-subtle);
  }
  .wistia-wrap wistia-player:not(:defined) {
    display: block;
    padding-top: calc(100% / var(--aspect));
  }
</style>

<script>
  const containers = document.querySelectorAll('[data-wistia-lazy]');
  let playerScriptLoaded = false;
  const loadedEmbeds = new Set();

  function loadEmbed(mediaId) {
    if (!playerScriptLoaded) {
      const s = document.createElement('script');
      s.src = 'https://fast.wistia.com/player.js';
      s.async = true;
      document.head.appendChild(s);
      playerScriptLoaded = true;
    }
    if (!loadedEmbeds.has(mediaId)) {
      const s = document.createElement('script');
      s.src = `https://fast.wistia.com/embed/${mediaId}.js`;
      s.async = true;
      s.type = 'module';
      document.head.appendChild(s);
      loadedEmbeds.add(mediaId);
    }
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadEmbed(entry.target.dataset.mediaId);
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '400px' }
    );
    containers.forEach((c) => observer.observe(c));
  } else {
    containers.forEach((c) => loadEmbed(c.dataset.mediaId));
  }
</script>
