---
interface Props {
  price?: string;
  originalPrice?: string;
  savingsLabel?: string;
  align?: 'center' | 'start';
}

const {
  price = '٩٩$',
  originalPrice = '١٤٩$',
  savingsLabel = '(وفّر ٣٠٪)',
  align = 'center',
} = Astro.props;
---

<div class:list={['price-tag', align]}>
  <span class="price-current">{price}</span>
  <span class="price-original">{originalPrice}</span>
  <span class="price-savings">{savingsLabel}</span>
</div>

<style>
  .price-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      135deg,
      rgba(0, 211, 141, 0.16),
      rgba(0, 184, 251, 0.1)
    );
    border: 1px solid rgba(0, 211, 141, 0.3);
    box-shadow: 0 0 24px rgba(0, 211, 141, 0.12);
  }
  .price-tag.center {
    justify-content: center;
  }
  .price-current {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    color: var(--accent);
  }
  .price-original {
    font-size: 1.1rem;
    color: var(--text-faint);
    text-decoration: line-through;
  }
  .price-savings {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
  }
</style>
