---
interface Props {
  price?: string;
  originalPrice?: string;
  savingsLabel?: string;
  align?: 'center' | 'start';
}

const {
  price = '٩٩$',
  originalPrice = '١٤٩$',
  savingsLabel = '(وفّر ٣٠٪)',
  align = 'center',
} = Astro.props;
---

<div class:list={['price-tag', align]}>
  <span class="price-current">{price}</span>
  <span class="price-original">{originalPrice}</span>
  <span class="price-savings">{savingsLabel}</span>
</div>

<style>
  .price-tag {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .price-tag.center {
    justify-content: center;
  }
  .price-current {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    color: var(--accent);
  }
  .price-original {
    font-size: 1.1rem;
    color: var(--text-faint);
    text-decoration: line-through;
  }
  .price-savings {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
  }
</style>
