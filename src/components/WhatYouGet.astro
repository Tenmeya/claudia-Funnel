---
import ResponsivePicture from './ResponsivePicture.astro';
import PriceTag from './PriceTag.astro';
import CTAButton from './CTAButton.astro';

interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;

const items = [
  '١٥ فيديو مسجّل وجاهز (دروس عملية).',
  'ملفات خاصة فيها أسرار بناء كلوديا (أوامر ومهارات).',
  'مجتمع خاص لكل المشتركين داخل التطبيق.',
  'قسم للمناقشة والأسئلة ومشاركة نجاحاتك.',
  'لقاءات حصرية أونلاين خاصة بالمشتركين على زووم.',
];
---

<section class="section section-alt what-you-get">
  <div class="container grid-layout">
    <div class="text-col">
      <h2 class="section-title" data-reveal style="text-align: start">
        ماذا ستحصل في الدورة؟
      </h2>
      <ul class="check-list">
        {items.map((item, i) => (
          <li data-reveal style={`--stagger-i: ${i + 2}`}>
            <span class="check-icon" aria-hidden="true">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <div data-reveal style="--stagger-i: 7">
        <PriceTag align="start" />
        <CTAButton href={checkoutUrl} size="lg" />
      </div>
    </div>
    <div class="image-col" data-reveal style="--stagger-i: 3">
      <ResponsivePicture
        name="bonus-gift"
        widths={[400, 700, 1254]}
        alt="ملفات وقوالب وأوامر جاهزة لبناء كلوديا"
        sizes="(max-width: 780px) 70vw, 380px"
        aspectRatio={1}
        class="gift-img"
      />
    </div>
  </div>
</section>

<style>
  .grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  @media (min-width: 780px) {
    .grid-layout {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-xl);
    }
  }
  .what-you-get :global(.price-tag) {
    margin-block-end: var(--space-md);
  }
  .image-col {
    display: flex;
    justify-content: center;
  }
  .what-you-get :global(.gift-img) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    max-width: 320px;
    width: 100%;
  }
</style>
