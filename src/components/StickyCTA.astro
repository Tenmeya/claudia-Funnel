---
import CTAButton from './CTAButton.astro';

interface Props {
  checkoutUrl: string;
}

const { checkoutUrl } = Astro.props;
---

<div class="sticky-cta" data-sticky-cta>
  <div class="sticky-cta-inner">
    <slot />
    <CTAButton href={checkoutUrl} size="md" eventName="Checkout click (sticky bar)" />
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    background: var(--surface-overlay);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 -1px 0 var(--border-hover), var(--shadow-lg);
    transform: translateY(100%);
    transition: transform var(--duration-medium) var(--ease-premium);
  }
  .sticky-cta::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: var(--brand-gradient);
    opacity: 0.5;
  }
  .sticky-cta.is-visible {
    transform: translateY(0);
  }
  .sticky-cta-inner {
    max-width: var(--container-width);
    margin-inline: auto;
    padding: 0.75rem var(--container-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
</style>

<script>
  const bar = document.querySelector('[data-sticky-cta]');
  const hero = document.querySelector('[data-hero]');

  if (bar && hero && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle('is-visible', !entry.isIntersecting);
      },
      { rootMargin: '0px' }
    );
    observer.observe(hero);
  } else if (bar) {
    bar.classList.add('is-visible');
  }
</script>
