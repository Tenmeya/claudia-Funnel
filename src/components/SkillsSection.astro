---
import PricingCard from './PricingCard.astro';

interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;

const items = [
  {
    text: 'تبسيط الأرقام المعقدة في مدير الإعلانات وتحليل حملاتك.',
    icon: 'M3 13.5V8m4.5 5.5V5M12 13.5V3m4.5 10.5v-7',
  },
  {
    text: 'اكتشاف أسباب هدر ميزانيتك ومشاركة إستراتيجية واضحة.',
    icon: 'M9 2a7 7 0 1 0 4.9 12l3.3 3.3M9 6v3l2 2',
  },
  {
    text: 'تحليل كل صفحة في موقعك الإلكتروني مع نصائح قوية.',
    icon: 'M2.5 4h13v10h-13V4Zm0 3h13M5.5 4v3',
  },
  {
    text: 'تحليل إعلانات المنافسين وكتابة إعلانات تخليك تتميّز وتفوز.',
    icon: 'M2.5 8 8 3l5.5 5v7h-11V8Zm3.5 7v-4h4v4',
  },
  {
    text: 'تجهيز تقارير تسويقية يومية توصلك بالتليفون.',
    icon: 'M5 2h6l3 3v11H5V2Zm2 6h4m-4 3h4',
  },
  {
    text: 'ومليون شي ثاني راح تتعلّمها بالدورة.',
    icon: 'M9 2.5 10.3 6.7 14.5 8 10.3 9.3 9 13.5 7.7 9.3 3.5 8 7.7 6.7 9 2.5Z',
  },
];
---

<section class="section skills-section">
  <div class="container">
    <h2 class="section-title" data-reveal>بعض مهارات كلوديا…</h2>
    <ul class="skill-grid">
      {items.map((item, i) => (
        <li class="skill-tile card" data-reveal style={`--stagger-i: ${i + 1}`}>
          <span class="skill-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path
                d={item.icon}
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span>{item.text}</span>
        </li>
      ))}
    </ul>
    <div data-reveal style="--stagger-i: 7">
      <PricingCard checkoutUrl={checkoutUrl} />
    </div>
  </div>
</section>

<style>
  .skills-section .container {
    max-width: 860px;
  }
  .skill-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-xl);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }
  @media (min-width: 620px) {
    .skill-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .skill-tile {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-md);
  }
  .skill-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 211, 141, 0.1);
    color: var(--accent-text);
  }
</style>
