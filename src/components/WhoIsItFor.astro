---
import PriceTag from './PriceTag.astro';
import CTAButton from './CTAButton.astro';

interface Props {
  checkoutUrl: string;
}
const { checkoutUrl } = Astro.props;

const items = [
  'مبيعاتك متذبذبة ومو عارف السبب.',
  'عندك حملات شغّالة بس شوي ضايع.',
  'تبي نتائج مستقرة كل شهر في مشروع.',
  'للحين مو عارف شلون تستخدم الAI في مشروعك.',
  'تبي تستغل موجه الAI وما تبي يطوفك القطار.',
];
---

<section class="section who-is-it-for">
  <div class="container" data-reveal>
    <h2 class="section-title">الدورة تناسبك إذا:</h2>
    <ul class="check-list">
      {items.map((item) => (
        <li>
          <span class="check-icon" aria-hidden="true">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <div class="cta-row">
      <PriceTag />
      <CTAButton href={checkoutUrl} size="lg" />
    </div>
  </div>
</section>

<style>
  .who-is-it-for .container {
    max-width: 640px;
  }
  .check-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .check-icon {
    flex-shrink: 0;
    color: var(--teal);
    font-weight: 800;
  }
  .cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }
</style>
