---
import PricingCard from './PricingCard.astro';

interface Props {
  checkoutUrl: string;
  heading?: string;
  items?: string[];
  // Index-aligned SVG path data. When supplied, each item renders as a
  // premium icon card (reusing the shared .card hover utility) instead of
  // the plain accent-dot row — left undefined, nothing changes.
  icons?: string[];
  showPricing?: boolean;
}

const {
  checkoutUrl,
  heading = 'الدورة تناسبك إذا:',
  items = [
    'مبيعاتك متذبذبة ومو عارف السبب.',
    'عندك حملات شغّالة بس شوي ضايع.',
    'تبي نتائج مستقرة كل شهر في مشروع.',
    'للحين مو عارف شلون تستخدم الAI في مشروعك.',
    'تبي تستغل موجه الAI وما تبي يطوفك القطار.',
  ],
  icons,
  showPricing = true,
} = Astro.props;
---

<section class="section section--tight who-is-it-for">
  <div class="container">
    <h2 class="section-title" data-reveal>{heading}</h2>
    <ul class="qualifier-grid">
      {items.map((item, i) => (
        <li
          class="qualifier-item"
          class:list={[icons && 'card has-icon']}
          data-reveal
          style={`--stagger-i: ${i + 1}`}
        >
          {icons ? (
            <span class="qualifier-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path
                  d={icons[i]}
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          ) : (
            <span class="qualifier-mark" aria-hidden="true"></span>
          )}
          <span>{item}</span>
        </li>
      ))}
    </ul>
    {showPricing && (
      <div data-reveal style="--stagger-i: 6">
        <PricingCard checkoutUrl={checkoutUrl} />
      </div>
    )}
  </div>
</section>

<style>
  .who-is-it-for .container {
    max-width: 760px;
  }
  .qualifier-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-xl);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }
  @media (min-width: 620px) {
    .qualifier-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .qualifier-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: var(--space-sm) var(--space-md);
    border-inline-start: 2px solid var(--accent);
    background: var(--card-bg);
    border-radius: var(--radius-sm);
    transition: background var(--duration-medium) var(--ease-premium);
  }
  .qualifier-item:hover {
    background: var(--card-bg-hover);
  }
  .qualifier-mark {
    flex-shrink: 0;
    margin-block-start: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .qualifier-item.has-icon {
    align-items: center;
    padding: var(--space-md);
  }
  .qualifier-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 211, 141, 0.1);
    color: var(--accent-text);
  }
</style>
