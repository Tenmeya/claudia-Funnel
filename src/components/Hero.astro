---
import ResponsivePicture from './ResponsivePicture.astro';
import PricingCard from './PricingCard.astro';
import Countdown from './Countdown.astro';
import CTAButton from './CTAButton.astro';

interface Props {
  checkoutUrl: string;
  badgeText?: string;
  headlinePrefix?: string;
  headlineHighlight?: string;
  subheadline?: string;
  metaItems?: { label: string; value: string }[];
  claudeProNote?: string;
  // 'full' (default) keeps the original hero: eyebrow badge, side portrait,
  // and the countdown+price offer block — this is what the light variant
  // still relies on via its defaults.
  // 'minimal' trims the hero down to logos → headline → subheadline →
  // badges → CTA only, per the approved content-hierarchy brief.
  variant?: 'full' | 'minimal';
}

const {
  checkoutUrl,
  badgeText = 'دورة كلوديا',
  headlinePrefix = 'خل كلود يدير',
  headlineHighlight = 'كل حملاتك الإعلانية',
  subheadline = 'تعلّم في بس ٩٠ دقيقة شلون تبني "كلوديا" مديرة تسويق تحلّل حملاتك، تكتب إعلاناتك، وتشتغل عنك ٢٤ ساعة كل يوم لزيادة مبيعاتك.',
  metaItems = [
    { label: 'المدة:', value: '٩٠ دقيقة' },
    { label: 'الدروس:', value: '١٥ درس' },
    { label: 'مقدّم الدورة:', value: 'عيد المجيبل' },
  ],
  claudeProNote,
  variant = 'full',
} = Astro.props;

const isMinimal = variant === 'minimal';
---

<section class="hero" data-hero>
  <div class="container hero-grid" class:list={[isMinimal && 'no-media']}>
    <div class="hero-copy" class:list={[isMinimal && 'centered']}>
      {isMinimal ? (
        <div class="hero-logos" data-reveal>
          <ResponsivePicture
            name="hero-logos"
            widths={[320, 480, 640]}
            alt="Claude و Meta"
            sizes="160px"
            loading="eager"
            aspectRatio={951 / 782}
            class="hero-logos-img"
          />
        </div>
      ) : (
        <span class="badge" data-reveal>{badgeText}</span>
      )}
      <h1 class="hero-headline" data-reveal style="--stagger-i: 1">
        {headlinePrefix} <span class="gradient-text">{headlineHighlight}</span>
      </h1>
      <p class="hero-sub" data-reveal style="--stagger-i: 2">
        {subheadline}
      </p>
      <ul class="hero-meta" class:list={[isMinimal && 'badges']} data-reveal style="--stagger-i: 3">
        {metaItems.map((item) => (
          <li><strong>{item.label}</strong> {item.value}</li>
        ))}
      </ul>
      {claudeProNote && (
        <p class="hero-note" data-reveal style="--stagger-i: 3">
          {claudeProNote}
        </p>
      )}
      {isMinimal ? (
        <div class="hero-cta-solo" data-reveal style="--stagger-i: 4">
          <CTAButton href={checkoutUrl} size="lg" />
        </div>
      ) : (
        <div class="hero-offer" data-reveal style="--stagger-i: 4">
          <div class="hero-countdown">
            <span class="countdown-intro">ينتهي العرض خلال:</span>
            <Countdown durationHours={48} align="start" />
          </div>
          <PricingCard checkoutUrl={checkoutUrl} />
        </div>
      )}
    </div>
    {!isMinimal && (
      <div class="hero-media" data-reveal style="--stagger-i: 2">
        <div class="hero-media-glow" aria-hidden="true"></div>
        <ResponsivePicture
          name="hero"
          widths={[480, 700, 1050, 1406]}
          alt="عيد المجيبل، مقدّم دورة كلوديا"
          sizes="(max-width: 780px) 90vw, 480px"
          loading="eager"
          fetchpriority="high"
          aspectRatio={1406 / 2000}
          class="hero-img"
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    overflow: clip;
    padding-block-start: var(--space-2xl);
    padding-block-end: var(--space-lg);
    background: radial-gradient(
        circle at 20% 0%,
        rgba(0, 211, 141, 0.14),
        transparent 55%
      ),
      radial-gradient(circle at 90% 10%, rgba(0, 184, 251, 0.12), transparent 50%),
      var(--bg-dark);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: start;
  }
  @media (min-width: 780px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-xl);
    }
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
    margin-block-end: var(--space-md);
  }
  .badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-gradient);
  }
  .hero-headline {
    font-size: var(--fs-hero);
    font-weight: 800;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-md);
  }
  .hero-sub {
    color: var(--text-muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-snug);
    max-width: 34rem;
    margin-block-end: var(--space-md);
  }
  .hero-meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    padding: 0;
    margin: 0 0 var(--space-lg);
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .hero-meta li {
    position: relative;
    padding-inline-end: var(--space-md);
  }
  .hero-meta li:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-end: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 0.85em;
    background: var(--border-subtle);
  }
  .hero-meta strong {
    color: var(--text-primary);
    font-weight: 700;
  }
  .hero-note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    margin: 0 0 var(--space-lg);
    border-radius: var(--radius-pill);
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .hero-offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero-countdown {
    margin-block-end: var(--space-md);
  }
  .countdown-intro {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-block-end: var(--space-xs);
  }
  .hero-media {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .hero-media-glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 211, 141, 0.22),
      transparent 65%
    );
    filter: blur(30px);
    z-index: 0;
  }
  /* Minimal variant — logos-first hero with no side portrait or offer block */
  .hero-grid.no-media {
    max-width: 720px;
    margin-inline: auto;
  }
  @media (min-width: 780px) {
    .hero-grid.no-media {
      grid-template-columns: 1fr;
    }
  }
  .hero-copy.centered {
    text-align: center;
  }
  .hero-copy.centered .hero-sub {
    margin-inline: auto;
  }
  .hero-copy.centered .hero-meta.badges {
    justify-content: center;
  }
  .hero-copy.centered .hero-cta-solo {
    display: flex;
    justify-content: center;
  }
  .hero-logos {
    display: flex;
    justify-content: center;
    margin-block-end: var(--space-sm);
  }
  .hero :global(.hero-logos-img) {
    width: 100%;
    max-width: 130px;
    height: auto;
  }
  .hero-meta.badges {
    gap: 0.6rem;
  }
  .hero-meta.badges li {
    padding: 0.45rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    transition: transform var(--duration-medium) var(--ease-premium),
      border-color var(--duration-medium) var(--ease-premium);
  }
  .hero-meta.badges li::after {
    display: none;
  }
  .hero-meta.badges li:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
  }
  .hero-cta-solo {
    margin-block-start: var(--space-xs);
  }
  .hero :global(.hero-img) {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    max-width: 420px;
    width: 100%;
    height: auto;
    animation: float 6s var(--ease-standard) infinite;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero-img) {
      animation: none;
    }
  }
</style>
